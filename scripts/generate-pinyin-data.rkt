#lang racket/base

;; Generate Fulcrum's compact, tone-free pinyin lookup table from the pinned
;; mozillazg/pinyin-data source file. The source is MIT licensed; see
;; THIRD_PARTY_NOTICES.md. This script is a maintainer tool, not a runtime
;; download path.

(require racket/cmdline
         racket/list
         racket/string)

(define source-path #f)
(define output-path #f)

(command-line
 #:program "generate-pinyin-data.rkt"
 #:args (source output)
 (set! source-path source)
 (set! output-path output))

(define umlaut-u-chars
  '(#\ü #\ǖ #\ǘ #\ǚ #\ǜ #\Ü #\Ǖ #\Ǘ #\Ǚ #\Ǜ))

(define (tone-free reading)
  ;; Pinyin keyboard input conventionally spells u-umlaut as v. Replace it
  ;; before NFD decomposition, then discard tone/combining marks.
  (define with-v
    (list->string
     (for/list ([ch (in-string reading)])
       (if (member ch umlaut-u-chars) #\v ch))))
  (list->string
   (for/list ([ch (in-string (string-normalize-nfd with-v))]
              #:when (or (char-alphabetic? ch)
                         (char=? ch #\v))
              #:unless (member (char-general-category ch) '(mn mc me)))
     (char-downcase ch))))

(define line-rx #px"^U\\+([0-9A-F]+):[ ]+([^ ]+)")

(define entries
  (call-with-input-file source-path
    (lambda (in)
      (for/list ([line (in-lines in)]
                 #:do [(define match (regexp-match line-rx line))]
                 #:when match)
        (define codepoint (string->number (list-ref match 1) 16))
        (define all-readings
          (remove-duplicates
           (filter (lambda (s) (not (string=? s "")))
                   (map tone-free
                        (string-split (list-ref match 2) ",")))))
        (define readings (take all-readings (min 4 (length all-readings))))
        (cons codepoint (list->vector readings))))))

(call-with-output-file output-path
  #:exists 'truncate/replace
  (lambda (out)
    (displayln ";; Generated by scripts/generate-pinyin-data.rkt." out)
    (displayln ";; Source pin and license: THIRD_PARTY_NOTICES.md." out)
    (write (make-immutable-hasheqv entries) out)
    (newline out)))

(printf "wrote ~a readings to ~a\n" (length entries) output-path)
