<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- No content background: the DesktopAcrylicBackdrop set on the window
         is the surface (frosted glass, matching the macOS panel). -->
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="QueryBox"
            Grid.Row="0"
            Margin="18,16,18,8"
            PlaceholderText="Search apps, clipboard, snippets, the web…"
            IsSpellCheckEnabled="False"
            TextChanged="QueryBox_TextChanged"
            KeyDown="QueryBox_KeyDown"
            CornerRadius="8"
            Background="Transparent"
            BorderBrush="Transparent"
            FontSize="17" />

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Margin="14,0,14,0"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational"
            Message="Starting embedded Racket CS…" />

        <StackPanel
            x:Name="AiPanel"
            Grid.Row="2"
            Margin="18,6,18,4"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock
                x:Name="AiPhase"
                Text="AI is answering…"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#D97706"
                Opacity="0.9" />
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="AiText"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    FontSize="13"
                    LineHeight="20" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel
            x:Name="DetailPanel"
            Grid.Row="2"
            Margin="18,6,18,4"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock
                x:Name="DetailHeader"
                Text="Details"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#D97706"
                Opacity="0.9" />
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="DetailText"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        FontSize="13" />
                    <ItemsControl x:Name="DetailMetadata">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="11" Opacity="0.6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Rows are built in code (icon tile + title/subtitle + badge +
             ↵ chip): no item template here on purpose. Container styling
             keeps the inset rounded look. -->
        <ListView
            x:Name="ResultsList"
            Grid.Row="4"
            Margin="8,4,8,0"
            SelectionMode="Single"
            DoubleTapped="ResultsList_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Margin" Value="4,1,4,1"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Grid Grid.Row="5" Margin="18,6,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="HintBar"
                Grid.Column="0"
                Opacity="0.45"
                FontSize="11"
                Text="↑↓ navigate · ↵ run · ctrl+k actions · esc hide" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Margin="12,0,0,0"
                Opacity="0.6"
                FontSize="11"
                TextAlignment="End"
                TextTrimming="CharacterEllipsis"
                Text="Starting embedded Racket CS…" />
        </Grid>
    </Grid>
</Window>
