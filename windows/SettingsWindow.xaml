<Window
    x:Class="RivetHost.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Settings grammar: section titles over cards, one row per
         setting with the control trailing. Every control carries its
         backend key in Tag; the code-behind writes through settings-set. -->
    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,4,16,4" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,18,0,6" />
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,16,0" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="MinHeight" Value="52" />
            </Style>
        </Grid.Resources>

        <ScrollViewer>
            <StackPanel Margin="32,4,32,32" MaxWidth="720" HorizontalAlignment="Stretch">

                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" Text="Language" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Tag="language" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="中文" Tag="zh" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel" Text="Theme" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Tag="theme" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="System" Tag="system" />
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HotkeyLabel" Text="Hotkey" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" Tag="hotkey" MinWidth="200"
                                     VerticalAlignment="Center" PlaceholderText="alt+space"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Modifiers alt / ctrl / shift / win plus a key: space, a–z, 0–9, f1–f12, comma, period, minus, equal, tab. Applies immediately; a taken combo falls back to Ctrl+Alt+Space." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MaxResultsLabel" Text="Maximum results" Style="{StaticResource RowLabel}" />
                            <NumberBox x:Name="MaxResultsBox" Grid.Column="1" Tag="max-results"
                                       Minimum="5" Maximum="25" SpinButtonPlacementMode="Inline"
                                       VerticalAlignment="Center" ValueChanged="Number_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Features" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClipboardLabel" Text="Record clipboard history" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="ClipboardSwitch" Grid.Column="1" Tag="clipboard-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Clipboard history limit" Style="{StaticResource RowLabel}" />
                            <NumberBox x:Name="ClipboardLimitBox" Grid.Column="1" Tag="clipboard-limit"
                                       Minimum="10" Maximum="100000" MinWidth="160"
                                       VerticalAlignment="Center" ValueChanged="Number_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WebSearchLabel" Text="Web search rows (bangs and fallback)" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="WebSearchSwitch" Grid.Column="1" Tag="web-search-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Default bang" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="DefaultBangBox" Grid.Column="1" Tag="default-engine" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="!g" Tag="!g" />
                                <ComboBoxItem Content="!d" Tag="!d" />
                                <ComboBoxItem Content="!gh" Tag="!gh" />
                                <ComboBoxItem Content="!so" Tag="!so" />
                                <ComboBoxItem Content="!w" Tag="!w" />
                                <ComboBoxItem Content="!yt" Tag="!yt" />
                                <ComboBoxItem Content="!m" Tag="!m" />
                                <ComboBoxItem Content="!t" Tag="!t" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExpansionLabel" Text="Expand snippet keywords as you type in any app" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="ExpansionSwitch" Grid.Column="1" Tag="expansion-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PluginsLabel" Text="Load plugins" Style="{StaticResource RowLabel}" />
                            <ToggleSwitch x:Name="PluginsSwitch" Grid.Column="1" Tag="plugins-enabled"
                                          OnContent="" OffContent="" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="Toggle_Toggled" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Plugin call timeout (ms)" Style="{StaticResource RowLabel}" />
                            <NumberBox x:Name="PluginTimeoutBox" Grid.Column="1" Tag="plugins-timeout-ms"
                                       Minimum="100" Maximum="10000" MinWidth="160"
                                       VerticalAlignment="Center" ValueChanged="Number_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="AI" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProviderLabel" Text="Provider" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="ProviderBox" Grid.Column="1" Tag="ai-provider" MinWidth="160"
                                      VerticalAlignment="Center" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="Off" Tag="" />
                                <ComboBoxItem Content="OpenAI" Tag="openai" />
                                <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                                <ComboBoxItem Content="Ollama" Tag="ollama" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="ModelBox" Grid.Column="1" Tag="ai-model" MinWidth="240"
                                     VerticalAlignment="Center" PlaceholderText="provider default"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base URL" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="BaseUrlBox" Grid.Column="1" Tag="ai-base-url" MinWidth="240"
                                     VerticalAlignment="Center" PlaceholderText="provider default"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Persona" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="PersonaBox" Grid.Column="1" Tag="ai-persona" MinWidth="240"
                                     VerticalAlignment="Center" PlaceholderText="prepended to every request"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API key" Style="{StaticResource RowLabel}" />
                            <PasswordBox x:Name="KeyBox" Grid.Column="1" MinWidth="240" VerticalAlignment="Center"
                                         PlaceholderText="paste a key" KeyDown="Key_KeyDown" />
                            <Button x:Name="SaveKeyButton" Grid.Column="2" Content="Save" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Click="SaveKey_Click" />
                        </Grid>
                        <TextBlock x:Name="AiStatusText" Style="{StaticResource Hint}" Text="" />
                        <TextBlock x:Name="KeyNotice" Style="{StaticResource Hint}" Text="" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Stored in ai-keys.json on this PC; never mirrored to the sync folder." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Sync &amp; Updates" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sync folder (beta)" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="SyncRootBox" Grid.Column="1" Tag="sync-root" MinWidth="280"
                                     VerticalAlignment="Center" PlaceholderText="empty = off"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A folder a file sync service replicates (OneDrive, Dropbox, Syncthing); settings and snippets mirror there." />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Update feed base URL" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="UpdateUrlBox" Grid.Column="1" Tag="update-base-url" MinWidth="280"
                                     VerticalAlignment="Center" PlaceholderText="https://…"
                                     LostFocus="Text_LostFocus" KeyDown="Text_KeyDown" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Margin="0,16,0,0" Foreground="#D13438"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
